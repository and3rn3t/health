{
  "name": "vitalsense-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src/ --cache --cache-location .eslintcache",
    "lint:fix": "eslint src/ --fix --cache --cache-location .eslintcache",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "ios:open": "open ios/Andernet-Posture/*.xcodeproj",
    "gait:sync": "node scripts/analysis/gait/sync-gait-config.js",
    "fallrisk:sync": "node scripts/analysis/fall/sync-fall-risk-config.js",
    "analytics:sync": "pnpm gait:sync && pnpm fallrisk:sync",
    "clean": "rm -rf dist dist-worker node_modules/.vite",
    "clean:all": "rm -rf dist dist-worker node_modules",
    "preinstall": "node scripts/ci/ensure-node-version.mjs",
    "build:worker": "node scripts/build/build-worker.js",
    "build:all": "vite build && node scripts/build/build-worker.js",
    "validate": "tsc --noEmit && eslint src/ && vitest run",
    "test:coverage": "vitest run --coverage || exit 0",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:smoke": "node scripts/deploy/smoke-test.mjs",
    "deploy:smoke:prod": "node scripts/deploy/smoke-test.mjs --env production",
    "doctor": "node scripts/dev/doctor.mjs",
    "check:drift": "node scripts/ci/check-config-drift.mjs",
    "check:openapi": "node scripts/ci/check-openapi-drift.mjs",
    "check:bundle": "node scripts/ci/check-bundle-size.mjs",
    "check:coverage": "node scripts/ci/coverage-ratchet.mjs",
    "check:coverage:update": "node scripts/ci/coverage-ratchet.mjs --update",
    "analyze": "ANALYZE=true vite build",
    "generate:api-types": "node scripts/ci/generate-api-types.mjs",
    "check:api-types": "node scripts/ci/generate-api-types.mjs --check",
    "check:deadcode": "knip",
    "test:mutate": "npx stryker run",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
