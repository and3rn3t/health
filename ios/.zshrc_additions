# Enhanced .zshrc additions for VitalSense iOS/Swift development
# Usage: source /path/to/health/ios/.zshrc_additions
# Paths are resolved relative to this file — no hardcoded user paths.

# Resolve project root from this file's location
VITALSENSE_IOS_ROOT="${0:a:h}"
VITALSENSE_ROOT="${VITALSENSE_IOS_ROOT:h}"

# ============= iOS Development Aliases =============
alias xcode="open -a Xcode"
alias simulator="open -a Simulator"
alias ios-sim="xcrun simctl"
alias devices="xcrun simctl list devices"
alias reset-sim="xcrun simctl erase all"

# Project-specific aliases (portable)
alias vs="cd \"$VITALSENSE_ROOT\""
alias vs-ios="cd \"$VITALSENSE_IOS_ROOT\""
alias vs-open="open \"$VITALSENSE_IOS_ROOT/Andernet-Posture/Andernet Posture.xcodeproj\""
alias vs-build="cd \"$VITALSENSE_IOS_ROOT\" && make build"
alias vs-test="cd \"$VITALSENSE_IOS_ROOT\" && make test"
alias vs-lint="cd \"$VITALSENSE_IOS_ROOT\" && make lint"
alias vs-clean="cd \"$VITALSENSE_IOS_ROOT\" && make clean"

# Web project shortcuts
alias vs-dev="cd \"$VITALSENSE_ROOT\" && pnpm dev"
alias vs-worker="cd \"$VITALSENSE_ROOT\" && pnpm cf:dev"
alias vs-validate="cd \"$VITALSENSE_ROOT\" && pnpm validate"

# ============= Git Enhancements =============
alias gs="git status"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gl="git pull"
alias gd="git diff"
alias gb="git branch"
alias gco="git checkout"
alias glog="git log --oneline --graph --decorate --all"

# ============= Swift/iOS Functions =============
swiftlint-fix() {
    if command -v swiftlint &> /dev/null; then
        swiftlint --fix
        echo "✅ SwiftLint auto-fixes applied"
    elif command -v docker &> /dev/null; then
        docker run --rm -v "$(pwd):/workspace" ghcr.io/realm/swiftlint:latest swiftlint --fix /workspace
        echo "✅ SwiftLint auto-fixes applied (via Docker)"
    else
        echo "⚠️  SwiftLint not available. Install via: brew install swiftlint"
    fi
}

boot-simulator() {
    local device=${1:-"iPhone 17 Pro"}
    echo "🚀 Booting $device..."
    xcrun simctl boot "$device" 2>/dev/null || echo "Device already booted or not found"
    open -a Simulator
}

shutdown-simulators() {
    echo "🛑 Shutting down all simulators..."
    xcrun simctl shutdown all
}

# ============= Utility Functions =============
build-time() {
    local start_time=$(date +%s)
    "$@"
    local end_time=$(date +%s)
    echo "⏱️  Command completed in $((end_time - start_time)) seconds"
}

xcode-processes() {
    echo "Xcode-related processes:"
    ps aux | grep -E "(Xcode|xcodebuild|simulator)" | grep -v grep
}

echo "✅ VitalSense shell aliases loaded (iOS: $VITALSENSE_IOS_ROOT)"