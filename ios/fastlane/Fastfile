# Fastlane configuration for Andernet Posture
# Requires: bundle install
# Environment variables (set via CI or shell):
#   APP_IDENTIFIER     (e.g. dev.andernet.posture.Andernet-Posture)
#   TEAM_ID            (Apple Developer Team ID - C8U3P6AJ6L)
#   FASTLANE_USER      (Apple ID email)
#   APP_STORE_CONNECT_API_KEY_PATH (optional JSON key for API auth)

fastlane_version '2.220.0'

WORK_DIR = '../Andernet-Posture'.freeze
PROJECT  = 'Andernet Posture.xcodeproj'.freeze
SCHEME   = 'Andernet Posture'.freeze

def shared_build_settings
  {
    project:       PROJECT,
    scheme:        SCHEME,
    configuration: 'Release'
  }
end

def test_settings
  {
    project:          PROJECT,
    scheme:           SCHEME,
    devices:          ['iPhone 16 Pro'],
    result_bundle:    true,
    buildlog_path:    'fastlane/build_logs',
    output_directory: 'fastlane/test_output'
  }
end

def archive_output
  'build/AndernetPosture.xcarchive'
end

platform :ios do
  desc 'Run unit tests with coverage'
  lane :tests do
    Dir.chdir(WORK_DIR) { run_tests(test_settings.merge(only_testing: 'Andernet PostureTests')) }
  end

  desc 'Build an unsigned archive'
  lane :build do
    Dir.chdir(WORK_DIR) do
      gym(shared_build_settings.merge(
        archive_path:     archive_output,
        skip_codesigning: true,
        clean:            true,
        output_directory: 'build',
        output_name:      'AndernetPosture-unsigned'
      ))
    end
  end

  desc 'Archive + export App Store IPA (requires signing & ExportOptions plist)'
  lane :archive do |options|
    plist = options[:export_options] || 'Andernet Posture/ExportOptions-AppStore.plist'
    Dir.chdir(WORK_DIR) do
      gym(shared_build_settings.merge(
        export_method:    'app-store',
        export_options:   plist,
        clean:            true,
        output_directory: 'build',
        output_name:      'AndernetPosture-AppStore'
      ))
    end
  end

  desc 'Sync signing assets with match (optional; set MATCH_GIT_URL)'
  lane :sync_signing do
    unless ENV['MATCH_GIT_URL']
      UI.important('MATCH_GIT_URL not set; skipping match signing sync')
      next
    end
    match(type: 'appstore',    readonly: false, app_identifier: [ENV['APP_IDENTIFIER']])
    match(type: 'development', readonly: false, app_identifier: [ENV['APP_IDENTIFIER']])
  end

  desc 'Submit to TestFlight (requires credentials / API key)'
  lane :beta do |_options|
    sync_signing
    Dir.chdir(WORK_DIR) do
      gym(shared_build_settings.merge(
        export_method:    'app-store',
        clean:            true,
        output_directory: 'build',
        output_name:      'AndernetPosture-Beta'
      ))
    end
    if ENV['APP_STORE_CONNECT_API_KEY_PATH']
      api_key = app_store_connect_api_key(key_filepath: ENV['APP_STORE_CONNECT_API_KEY_PATH'])
      pilot(api_key: api_key, skip_waiting_for_build_processing: true)
    else
      pilot(skip_waiting_for_build_processing: true)
    end
  end

  desc 'Run SwiftLint'
  lane :lint do
    Dir.chdir(WORK_DIR) do
      if File.exist?('.swiftlint.yml')
        sh 'if which swiftlint >/dev/null; then swiftlint --strict; else echo "SwiftLint not installed"; fi'
      end
    end
  end

  desc 'Bump marketing version (type: patch|minor|major) and tag'
  lane :bump_version do |options|
    type = (options[:type] || 'patch').to_s
    Dir.chdir(WORK_DIR) { increment_version_number(bump_type: type) }
    version = Dir.chdir(WORK_DIR) { get_version_number(xcodeproj: PROJECT, target: SCHEME) }
    sh 'git add .'
    sh "git commit -m 'chore: bump version to #{version}' || echo 'No changes to commit'"
    sh "git tag v#{version} || echo 'Tag exists'"
    UI.success("Version bumped to #{version}")
  end

  desc 'Upload dSYMs from last archive'
  lane :upload_symbols do
    Dir.chdir(WORK_DIR) { sh "bash scripts/upload-dsyms.sh #{archive_output} build/dSYMs" }
  end

  desc 'Generate coverage report via slather'
  lane :coverage do
    tests
    if File.exist?('fastlane/slather.yml')
      begin
        slather(build_directory: 'fastlane/test_output', output_directory: 'fastlane/coverage')
      rescue => e
        UI.important("Slather failed: #{e.message}")
      end
    else
      UI.message('No slather.yml, skipping coverage step')
    end
  end

  desc 'Full CI pipeline: lint -> tests -> build'
  lane :ci do
    lint
    tests
    build
  end

  desc 'Verify Fastfile syntax'
  lane :test_syntax do
    UI.success('Fastfile syntax OK')
  end

  desc 'Diagnostic information for build troubleshooting'
  lane :diagnose do
    UI.message('Running diagnostics...')

    xcode_version = sh('xcodebuild -version', log: false)
    UI.message("Xcode: #{xcode_version}")

    Dir.chdir(WORK_DIR) do
      UI.success("Project exists: #{File.exist?(PROJECT)}")

      begin
        schemes = sh("xcodebuild -project '#{PROJECT}' -list", log: false)
        UI.message("Schemes:\n#{schemes}")
      rescue => e
        UI.error("Could not list schemes: #{e.message}")
      end

      begin
        sh("xcodebuild -resolvePackageDependencies -project '#{PROJECT}' -scheme '#{SCHEME}' 2>&1 | tail -5", log: true)
        UI.success('Swift packages resolved')
      rescue => e
        UI.important("Package resolution warning: #{e.message}")
      end

      begin
        settings = sh("xcodebuild -project '#{PROJECT}' -scheme '#{SCHEME}' -showBuildSettings 2>&1 | head -30", log: false)
        UI.message("Build Settings (first 30 lines):\n#{settings}")
      rescue => e
        UI.important("Could not show build settings: #{e.message}")
      end
    end

    UI.success('Diagnostics complete')
  end

  desc 'Build with optimizations (Release, unsigned)'
  lane :build_optimized do
    UI.message('Starting optimized build...')
    sh 'rm -rf ~/Library/Developer/Xcode/DerivedData 2>/dev/null || true'
    Dir.chdir(WORK_DIR) do
      gym(shared_build_settings.merge(
        archive_path:     'build/AndernetPosture-Optimized.xcarchive',
        skip_codesigning: true,
        clean:            true,
        output_directory: 'build',
        output_name:      'AndernetPosture-Optimized',
        xcargs:           'CODE_SIGNING_ALLOWED=NO COMPILER_INDEX_STORE_ENABLE=NO SWIFT_WHOLE_MODULE_OPTIMIZATION=YES GCC_OPTIMIZATION_LEVEL=fast'
      ))
    end
    UI.success('Optimized build complete!')
  end

  desc 'Build optimized for ARKit/gait analysis workloads'
  lane :build_posture do
    UI.message('Building posture analysis optimized version...')
    Dir.chdir(WORK_DIR) do
      gym(shared_build_settings.merge(
        archive_path:     'build/AndernetPosture-Posture.xcarchive',
        skip_codesigning: true,
        clean:            true,
        output_directory: 'build',
        output_name:      'AndernetPosture-Posture',
        xcargs:           'CODE_SIGNING_ALLOWED=NO MTL_FAST_MATH=YES GCC_UNROLL_LOOPS=YES GCC_VECTORIZE_LOOPS=YES SWIFT_DETERMINISTIC_HASHING=YES'
      ))
    end
    UI.success('Posture build complete!')
  end

  desc 'Performance testing with metrics collection'
  lane :performance_test do
    Dir.chdir(WORK_DIR) do
      run_tests(test_settings.merge(
        configuration:    'Release',
        xcargs:           '-enableCodeCoverage YES -parallel-testing-enabled YES',
        output_directory: 'fastlane/performance_results'
      ))
    end
    UI.success('Performance tests complete!')
  end

  desc 'Clean build caches and re-resolve SPM packages'
  lane :optimize_cache do
    UI.message('Cleaning build caches...')
    sh 'rm -rf ~/Library/Developer/Xcode/DerivedData 2>/dev/null || true'
    sh 'rm -rf ~/Library/Caches/org.swift.swiftpm 2>/dev/null || true'
    Dir.chdir(WORK_DIR) do
      sh 'rm -rf .build 2>/dev/null || true'
      sh("xcodebuild -resolvePackageDependencies -project '#{PROJECT}' -scheme '#{SCHEME}'")
    end
    UI.success('Build cache optimized!')
  end

  desc 'Complete performance CI pipeline'
  lane :performance_ci do
    UI.message('Starting performance CI pipeline...')
    optimize_cache
    lint
    performance_test
    build_posture
    UI.success('Performance CI complete!')
  end
end
