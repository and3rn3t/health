			"label": "🐳 Docker: Health (worker)",
			"type": "shell",
			"command": "pwsh",
			"args": [
				"-NoProfile",
				"-Command",
				"try { $r = Invoke-WebRequest 'http://127.0.0.1:8789/health' -TimeoutSec 5; Write-Host 'Worker:' $r.StatusCode } catch { Write-Host 'Worker: ERROR' $_.Exception.Message }"
			],
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"panel": "shared",
				"clear": true
