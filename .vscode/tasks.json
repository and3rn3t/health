{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "sweetpad",
      "action": "build",
      "scheme": "Andernet Posture",
      "configuration": "Debug",
      "problemMatcher": [
        "$sweetpad-watch",
        "$sweetpad-xcodebuild-default",
        "$sweetpad-xcbeautify-errors",
        "$sweetpad-xcbeautify-warnings"
      ],
      "label": "sweetpad: build",
      "detail": "Build the app",
      "isBackground": true,
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "type": "sweetpad",
      "action": "launch",
      "scheme": "Andernet Posture",
      "configuration": "Debug",
      "problemMatcher": [
        "$sweetpad-watch",
        "$sweetpad-xcodebuild-default",
        "$sweetpad-xcbeautify-errors",
        "$sweetpad-xcbeautify-warnings"
      ],
      "label": "sweetpad: launch",
      "detail": "Build and Launch the app",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": true
      }
    },
    {
      "type": "sweetpad",
      "action": "clean",
      "scheme": "Andernet Posture",
      "problemMatcher": [
        "$sweetpad-watch",
        "$sweetpad-xcodebuild-default",
        "$sweetpad-xcbeautify-errors",
        "$sweetpad-xcbeautify-warnings"
      ],
      "label": "sweetpad: clean",
      "detail": "Clean the app"
    },
    {
      "type": "sweetpad",
      "action": "test",
      "scheme": "Andernet Posture",
      "configuration": "Debug",
      "problemMatcher": [
        "$sweetpad-watch",
        "$sweetpad-xcodebuild-default",
        "$sweetpad-xcbeautify-errors",
        "$sweetpad-xcbeautify-warnings"
      ],
      "label": "sweetpad: test",
      "detail": "Run unit tests",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "sweetpad",
      "action": "resolve-dependencies",
      "scheme": "Andernet Posture",
      "problemMatcher": [
        "$sweetpad-xcodebuild-default"
      ],
      "label": "sweetpad: resolve-dependencies",
      "detail": "Resolve Swift Package Manager dependencies"
    },
    {
      "label": "iOS: Swift Lint",
      "type": "shell",
      "command": "cd ios && make lint",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "iOS: Swift Format",
      "type": "shell",
      "command": "cd ios && make format",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "iOS: Build Simulator",
      "type": "shell",
      "command": "cd ios && make build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Dev Server",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Validate (lint + type-check + test)",
      "type": "shell",
      "command": "pnpm validate",
      "group": "test",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Type Check",
      "type": "shell",
      "command": "pnpm type-check",
      "group": "test",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "pnpm lint",
      "group": "test",
      "problemMatcher": [
        "$eslint-stylish"
      ]
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "pnpm test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Test (Watch)",
      "type": "shell",
      "command": "pnpm test -- --watch",
      "isBackground": true,
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run E2E tests",
      "type": "shell",
      "command": "pnpm test:e2e",
      "group": "test",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Worker Dev (port 8789)",
      "type": "shell",
      "command": "pnpm cf:dev",
      "isBackground": true,
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Worker Tail (dev)",
      "type": "shell",
      "command": "wrangler tail --env development --format pretty",
      "isBackground": true,
      "group": "test"
    },
    {
      "label": "Worker Tail (prod)",
      "type": "shell",
      "command": "wrangler tail --env production --format pretty",
      "isBackground": true,
      "group": "test"
    },
    {
      "label": "Deploy Worker (dev)",
      "type": "shell",
      "command": "pnpm cf:deploy",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Deploy Worker (prod)",
      "type": "shell",
      "command": "pnpm deploy:prod",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build App",
      "type": "shell",
      "command": "pnpm build",
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "Build Worker",
      "type": "shell",
      "command": "pnpm build:worker",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Bundle Analysis",
      "type": "shell",
      "command": "ANALYZE=true pnpm build",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Bundle Size Check",
      "type": "shell",
      "command": "pnpm check:bundle",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Docker: Up",
      "type": "shell",
      "command": "docker compose up -d",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Down",
      "type": "shell",
      "command": "docker compose down",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs (worker)",
      "type": "shell",
      "command": "docker compose logs -f worker",
      "isBackground": true,
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Docker: Logs (websocket)",
      "type": "shell",
      "command": "docker compose logs -f websocket",
      "isBackground": true,
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Docker: PS",
      "type": "shell",
      "command": "docker compose ps",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Doctor",
      "type": "shell",
      "command": "pnpm doctor",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Config Drift Check",
      "type": "shell",
      "command": "pnpm check:drift",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
