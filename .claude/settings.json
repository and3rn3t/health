{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(npm run lint *)",
      "Bash(npm run type-check *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run test *)",
      "Bash(npm run build *)",
      "Bash(npm run format *)",
      "Bash(npm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm type-check *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm build *)",
      "Bash(pnpm format *)",
      "Bash(npx vitest *)",
      "Bash(npx tsc --noEmit *)",
      "Bash(pytest *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(make lint *)",
      "Bash(make test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.dev.vars)",
      "Read(./**/.dev.vars)",
      "Read(./.secrets.local.json)"
    ]
  }
}
