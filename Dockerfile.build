# syntax=docker/dockerfile:1.7
# Build-only Dockerfile for CI/CD
# This image contains build tools and outputs, optimized for CI caching

FROM node:22-alpine AS build

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache \
    bash \
    git \
    python3 \
    make \
    g++ \
    libc6-compat \
    curl

# Install pnpm and configure for CI
RUN npm install -g pnpm@9 && \
    pnpm config set store-dir /root/.local/share/pnpm/store

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install all dependencies (including dev dependencies for building)
# Use cache mount for node_modules if available (BuildKit feature)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# Copy source files
COPY . .

# Build the application with error handling
RUN echo "🏗️ Building application..." && \
    pnpm run build || (echo "❌ App build failed" && exit 1)

# Build the worker
RUN echo "🔧 Building worker..." && \
    pnpm run build:worker || echo "⚠️ Worker build optional"

# Verify builds and show sizes
RUN echo "📊 Verifying builds..." && \
    if [ -d dist ]; then \
        echo "✅ App build successful ($(du -sh dist | cut -f1))"; \
        ls -la dist | head -10; \
    else \
        echo "❌ App build failed - dist/ missing"; \
        exit 1; \
    fi && \
    if [ -d dist-worker ]; then \
        echo "✅ Worker build successful ($(du -sh dist-worker | cut -f1))"; \
        ls -la dist-worker | head -10; \
    else \
        echo "⚠️ Worker build skipped"; \
    fi

# Output build artifacts to /build-output for easy extraction
RUN mkdir -p /build-output && \
    cp -r dist /build-output/ && \
    cp -r dist-worker /build-output/ && \
    echo "Build artifacts ready in /build-output"

# Default command shows build info
CMD ["sh", "-c", "echo 'Build complete. Artifacts in /build-output' && ls -la /build-output"]

