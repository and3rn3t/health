{
  "folders": [
    {
      "name": "Health App (Root)",
      "path": ".",
    },
    {
      "name": "iOS App",
      "path": "./ios",
    },
    {
      "name": "Documentation",
      "path": "./docs",
    },
    {
      "name": "Scripts",
      "path": "./scripts",
    },
  ],
  "settings": {
    // Workspace-specific overrides
    "files.exclude": {
      "**/node_modules": true,
      "**/dist": true,
      "**/dist-worker": true,
      "**/.wrangler": true,
      "**/DerivedData": true,
      "**/*.xcuserdata": true,
      "**/logs": true,
      "**/coverage": true,
      "**/.build": true,
      "**/Pods": true,
      "**/.cache": true,
      "**/*.tsbuildinfo": true,
    },

    // PowerShell settings (for .ps1 file editing)
    "powershell.scriptAnalysis.enable": true,
    "powershell.codeFormatting.preset": "OTBS",
    "powershell.codeFormatting.useConstantStrings": true,
    "powershell.codeFormatting.useCorrectCasing": true,

    // Terminal configuration
    "terminal.integrated.cwd": "${workspaceFolder}",

    // Task and terminal optimization
    "task.autoDetect": "on",
    "task.showDecorations": true,
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "both",
    "terminal.integrated.showCommandGuide": true,
    "terminal.integrated.tabs.title": "💙 ${process} • ${cwdBasename}",
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.confirmOnKill": "never",

    // Search optimization
    "search.followSymlinks": false,
    "search.smartCase": true,
    "search.exclude": {
      "**/logs/**": true,
      "**/.wrangler/**": true,
      "**/DerivedData/**": true,
      "**/node_modules/**": true,
      "**/coverage/**": true,
      "**/.build/**": true,
      "**/Pods/**": true,
      "**/*.xcuserdata/**": true,
    },

    // Language-specific settings
    "powershell.cwd": "Health App (Root)",
    "typescript.tsdk": "node_modules/typescript/lib",
    "swift.sourcekit-lsp.serverPath": "/usr/bin/sourcekit-lsp",

    // File associations for better syntax highlighting
    "files.associations": {
      "*.ps1": "powershell",
      "*.swift": "swift",
      "*.toml": "toml",
      "wrangler*.toml": "toml",
      "*.plist": "xml",
      "Podfile": "ruby",
      "Fastfile": "ruby",
      "*.yml": "yaml",
      "*.yaml": "yaml",
    },

    // Copilot optimization for this workspace
    "github.copilot.enable": {
      "*": true,
      "yaml": true,
      "plaintext": false,
      "markdown": true,
      "swift": true,
      "powershell": true,
      "typescript": true,
      "javascript": true,
    },
  },

  "extensions": {
    "recommendations": [
      "ms-vscode.powershell",
      "cloudflare.vscode-cloudflare-workers",
      "ms-vscode.vscode-typescript-next",
      "ms-vscode.vscode-json",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss",
      "ms-vscode.vscode-yaml",
      "tamasfe.even-better-toml",
      "redhat.vscode-xml",
      "ms-vsliveshare.vsliveshare",
      "formulahendry.auto-rename-tag",
      "streetsidesoftware.code-spell-checker",
    ],
  },

  "tasks": {
    "version": "2.0.0",
  },

  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug VitalSense Web App",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["dev"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
      },
      {
        "name": "Debug Wrangler Worker",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "pnpm",
        "runtimeArgs": ["cf:dev"],
        "cwd": "${workspaceFolder}",
        "console": "integratedTerminal",
        "internalConsoleOptions": "neverOpen",
      },
    ],
  },
}
