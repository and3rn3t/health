# syntax=docker/dockerfile:1.7
# Multi-stage Dockerfile for production builds
# Optimized for fast builds with layer caching

# ============================================================================
# Stage 1: Base dependencies
# ============================================================================
FROM node:22-alpine AS base
WORKDIR /app

# Install pnpm globally and build dependencies
RUN npm install -g pnpm@9 && \
    apk add --no-cache \
    bash \
    git \
    python3 \
    make \
    g++ \
    libc6-compat

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Copy scripts directory needed for preinstall hook
COPY scripts/ci/ensure-node-version.mjs ./scripts/ci/ensure-node-version.mjs

# Install dependencies (this layer will be cached if package files don't change)
# Use --frozen-lockfile for reproducible builds
# Use cache mount for pnpm store (BuildKit feature)
# Note: preinstall script will run and verify Node version (which matches the image)
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --prod=false

# ============================================================================
# Stage 2: Build stage
# ============================================================================
FROM base AS builder

# Copy source files needed for build
COPY tsconfig.json tsconfig.*.json ./
COPY vite.config.ts vite.*.config.ts ./
COPY postcss.config.js tailwind.config.js ./
COPY eslint.config.js ./
COPY index.html ./
COPY public ./public
COPY src ./src
COPY scripts ./scripts
COPY app-config.js ./
COPY wrangler.toml ./

# Build the application
RUN pnpm run build

# Build the worker
RUN pnpm run build:worker || echo "Worker build optional"

# Verify build outputs
RUN test -d dist && test -d dist-worker || (echo "Build failed - missing dist directories" && exit 1)

# ============================================================================
# Stage 3: Production runtime (minimal image)
# ============================================================================
FROM node:22-alpine AS production

WORKDIR /app

# Install only production dependencies and wrangler for deployment
RUN npm install -g pnpm@9 wrangler@latest

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install only production dependencies
RUN pnpm install --frozen-lockfile --prod

# Copy built artifacts from builder
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/dist-worker ./dist-worker

# Copy configuration files needed for deployment
COPY wrangler.toml ./
COPY app-config.js ./

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001 && \
    chown -R nodejs:nodejs /app

USER nodejs

# Default command (can be overridden)
CMD ["node", "--version"]

